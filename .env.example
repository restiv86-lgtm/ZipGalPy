# Local development: postgresql://USER:PASSWORD@localhost:5432/zipgalpy
# Production: use the managed PostgreSQL connection string from your server secret store.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zipgalpy?schema=public"

# Public origin of the web app. Use https://zipgalpy.co.kr in production.
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
