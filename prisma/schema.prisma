generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique @db.VarChar(320)
  passwordHash         String             @db.VarChar(255)
  name                 String?            @db.VarChar(50)
  nickname             String             @db.VarChar(30)
  emailVerifiedAt      DateTime?
  termsAgreedAt        DateTime?
  privacyAgreedAt      DateTime?
  marketingAgreed      Boolean            @default(false)
  marketingAgreedAt    DateTime?
  role                 UserRole           @default(USER)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  homes                Home[]
  apartmentMemberships ApartmentMember[]
  apartmentRequests    ApartmentRequest[]
  handledReports       CommunityReport[]  @relation("CommunityReportHandler")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Apartment {
  id               String            @id @default(cuid())
  externalCode     String            @db.VarChar(80)
  name             String            @db.VarChar(120)
  sido             String            @db.VarChar(30)
  sigungu          String            @db.VarChar(50)
  eupmyeondong     String?           @db.VarChar(60)
  roadAddress      String            @db.VarChar(240)
  jibunAddress     String?           @db.VarChar(240)
  dataSource       String            @db.VarChar(40)
  sourceUpdatedAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          ApartmentMember[]
  communityPosts   CommunityPost[]
  marketplacePosts MarketplacePost[]

  @@unique([dataSource, externalCode])
  @@index([name])
  @@index([sido, sigungu, eupmyeondong])
  @@index([roadAddress])
  @@map("apartments")
}

model ApartmentMember {
  id                String             @id @default(cuid())
  apartmentId       String
  userId            String
  joinedAt          DateTime           @default(now())
  apartment         Apartment          @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityPosts    CommunityPost[]    @relation("CommunityPostAuthor")
  communityComments CommunityComment[] @relation("CommunityCommentAuthor")
  communityReports  CommunityReport[]  @relation("CommunityReportReporter")
  marketplacePosts  MarketplacePost[]  @relation("MarketplaceSeller")

  @@unique([apartmentId, userId])
  @@index([userId, joinedAt])
  @@map("apartment_members")
}

enum CommunityPostCategory {
  GENERAL
  QUESTION
  INFO
  LOST_AND_FOUND
}

enum CommunityContentStatus {
  ACTIVE
  DELETED
}

enum CommunityReportReason {
  SPAM_AD
  ABUSE
  INAPPROPRIATE
  SUSPECTED_FRAUD
  OTHER
}

enum CommunityReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

model CommunityPost {
  id             String                 @id @default(cuid())
  apartmentId    String
  authorMemberId String?
  category       CommunityPostCategory
  title          String                 @db.VarChar(120)
  content        String                 @db.VarChar(5000)
  status         CommunityContentStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  apartment      Apartment              @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  authorMember   ApartmentMember?       @relation("CommunityPostAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)
  comments       CommunityComment[]
  reports        CommunityReport[]

  @@index([apartmentId, status, createdAt])
  @@index([authorMemberId])
  @@map("community_posts")
}

model CommunityComment {
  id             String                 @id @default(cuid())
  postId         String
  authorMemberId String?
  content        String                 @db.VarChar(1000)
  status         CommunityContentStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  post           CommunityPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorMember   ApartmentMember?       @relation("CommunityCommentAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)
  reports        CommunityReport[]

  @@index([postId, status, createdAt])
  @@index([authorMemberId])
  @@map("community_comments")
}

model CommunityReport {
  id               String                @id @default(cuid())
  reporterMemberId String?
  postId           String?
  commentId        String?
  reason           CommunityReportReason
  detail           String?               @db.VarChar(500)
  status           CommunityReportStatus @default(PENDING)
  handledAt        DateTime?
  handledById      String?
  adminMemo        String?               @db.VarChar(1000)
  createdAt        DateTime              @default(now())
  reporterMember   ApartmentMember?      @relation("CommunityReportReporter", fields: [reporterMemberId], references: [id], onDelete: SetNull)
  handledBy        User?                  @relation("CommunityReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  post             CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment          CommunityComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterMemberId, postId])
  @@unique([reporterMemberId, commentId])
  @@index([postId, createdAt])
  @@index([commentId, createdAt])
  @@index([status, createdAt])
  @@index([handledById])
  @@map("community_reports")
}

enum MarketplacePostType {
  SELL
  GIVEAWAY
}

enum MarketplacePostStatus {
  ACTIVE
  RESERVED
  COMPLETED
  CANCELLED
}

model MarketplacePost {
  id               String                @id @default(cuid())
  apartmentId      String
  sellerMemberId   String?
  sourceHomeItemId String?
  type             MarketplacePostType
  title            String                @db.VarChar(120)
  description      String                @db.VarChar(5000)
  price            Int
  status           MarketplacePostStatus @default(ACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  apartment        Apartment             @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  sellerMember     ApartmentMember?      @relation("MarketplaceSeller", fields: [sellerMemberId], references: [id], onDelete: SetNull)
  sourceHomeItem   HomeItem?             @relation(fields: [sourceHomeItemId], references: [id], onDelete: SetNull)

  @@index([apartmentId, status, createdAt])
  @@index([sellerMemberId])
  @@index([sourceHomeItemId])
  @@map("marketplace_posts")
}

enum ApartmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApartmentRequest {
  id            String                 @id @default(cuid())
  userId        String
  sido          String                 @db.VarChar(30)
  sigungu       String?                @db.VarChar(50)
  eupmyeondong  String?                @db.VarChar(60)
  apartmentName String                 @db.VarChar(120)
  address       String?                @db.VarChar(240)
  status        ApartmentRequestStatus @default(PENDING)
  requestedAt   DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@map("apartment_requests")
}

enum HousingType {
  APARTMENT
  VILLA
  DETACHED_HOUSE
  OFFICETEL
  OTHER
}

model Home {
  id            String         @id @default(cuid())
  userId        String
  name          String         @db.VarChar(40)
  address       String         @db.VarChar(200)
  addressDetail String?        @db.VarChar(100)
  housingType   HousingType
  area          Float?
  builtYear     Int?
  memo          String?        @db.VarChar(1000)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         HomeItem[]
  repairs       HomeRepair[]
  schedules     HomeSchedule[]
  expenses      HomeExpense[]
  contracts     HomeContract[]
  documents     HomeDocument[]

  @@index([userId, createdAt])
  @@map("homes")
}

enum HomeItemCategory {
  APPLIANCE
  FURNITURE
  KITCHEN
  HOUSEHOLD
  DIGITAL
  HOBBY
  CHILDCARE
  OTHER
}

enum HomeItemStatus {
  USING
  STORED
  REPAIRING
  SOLD
  GIVEN_AWAY
  DISPOSED
}

model HomeItem {
  id               String            @id @default(cuid())
  homeId           String
  name             String            @db.VarChar(120)
  category         HomeItemCategory
  brand            String?           @db.VarChar(80)
  modelName        String?           @db.VarChar(120)
  purchaseDate     DateTime?         @db.Date
  purchasePrice    Decimal?          @db.Decimal(14, 0)
  warrantyUntil    DateTime?         @db.Date
  memo             String?           @db.VarChar(2000)
  status           HomeItemStatus    @default(USING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  home             Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  images           HomeItemImage[]
  marketplacePosts MarketplacePost[]
  repairs          HomeRepair[]
  schedules        HomeSchedule[]
  expenses         HomeExpense[]
  documents        HomeDocument[]

  @@index([homeId, status, createdAt])
  @@map("home_items")
}

model HomeItemImage {
  id         String   @id @default(cuid())
  homeItemId String
  storageKey String   @db.VarChar(500)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  homeItem   HomeItem @relation(fields: [homeItemId], references: [id], onDelete: Cascade)

  @@index([homeItemId, sortOrder])
  @@map("home_item_images")
}

enum HomeRepairType {
  REPAIR
  INSPECTION
  CLEANING
  REPLACEMENT
  OTHER
}

model HomeRepair {
  id            String         @id @default(cuid())
  homeId        String
  homeItemId    String?
  type          HomeRepairType
  title         String         @db.VarChar(120)
  description   String         @db.VarChar(3000)
  repairDate    DateTime       @db.Date
  cost          Decimal?       @db.Decimal(14, 0)
  companyName   String?        @db.VarChar(120)
  nextCheckDate DateTime?      @db.Date
  memo          String?        @db.VarChar(2000)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  home          Home           @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeItem      HomeItem?      @relation(fields: [homeItemId], references: [id], onDelete: SetNull)
  schedules     HomeSchedule[]
  expenses      HomeExpense[]

  @@index([homeId, repairDate])
  @@index([homeItemId, repairDate])
  @@map("home_repairs")
}

enum HomeScheduleType {
  INSPECTION
  WARRANTY
  REPAIR
  CONTRACT
  PAYMENT
  OTHER
}

model HomeSchedule {
  id          String           @id @default(cuid())
  homeId      String
  homeItemId  String?
  repairId    String?
  title       String           @db.VarChar(120)
  scheduledAt DateTime
  type        HomeScheduleType
  completed   Boolean          @default(false)
  memo        String?          @db.VarChar(2000)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  home        Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeItem    HomeItem?        @relation(fields: [homeItemId], references: [id], onDelete: SetNull)
  repair      HomeRepair?      @relation(fields: [repairId], references: [id], onDelete: SetNull)

  @@index([homeId, completed, scheduledAt])
  @@index([homeItemId, scheduledAt])
  @@index([repairId])
  @@map("home_schedules")
}

enum HomeExpenseCategory {
  PURCHASE
  REPAIR
  MAINTENANCE
  MANAGEMENT
  UTILITY
  CONTRACT
  INSURANCE
  TAX
  OTHER
}

model HomeExpense {
  id            String              @id @default(cuid())
  homeId        String
  homeItemId    String?
  repairId      String?
  sourceKey     String?             @unique @db.VarChar(180)
  category      HomeExpenseCategory
  title         String              @db.VarChar(120)
  amount        Decimal             @db.Decimal(14, 0)
  expenseDate   DateTime            @db.Date
  paymentMethod String?             @db.VarChar(80)
  memo          String?             @db.VarChar(2000)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  home          Home                @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeItem      HomeItem?           @relation(fields: [homeItemId], references: [id], onDelete: SetNull)
  repair        HomeRepair?         @relation(fields: [repairId], references: [id], onDelete: SetNull)

  @@index([homeId, expenseDate])
  @@index([homeId, category, expenseDate])
  @@index([homeItemId])
  @@index([repairId])
  @@map("home_expenses")
}

enum HomeContractType {
  LEASE
  RENTAL
  INSURANCE
  INTERNET
  SECURITY
  MAINTENANCE
  SUBSCRIPTION
  OTHER
}

enum HomeContractStatus {
  ACTIVE
  TERMINATED
}

model HomeContract {
  id             String             @id @default(cuid())
  homeId         String
  type           HomeContractType
  title          String             @db.VarChar(120)
  companyName    String?            @db.VarChar(120)
  contractNumber String?            @db.VarChar(120)
  startDate      DateTime?          @db.Date
  endDate        DateTime?          @db.Date
  amount         Decimal?           @db.Decimal(14, 0)
  reminderDays   Int[]              @default([90, 60, 30, 7])
  memo           String?            @db.VarChar(2000)
  status         HomeContractStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  home           Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  documents      HomeDocument[]

  @@index([homeId, status, endDate])
  @@map("home_contracts")
}

enum HomeDocumentType {
  CONTRACT
  WARRANTY
  RECEIPT
  MANUAL
  INSURANCE
  TAX
  CERTIFICATE
  OTHER
}

enum HomeDocumentStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
}

model HomeDocument {
  id             String             @id @default(cuid())
  homeId         String
  homeItemId     String?
  contractId     String?
  type           HomeDocumentType
  title          String             @db.VarChar(120)
  documentNumber String?            @db.VarChar(120)
  issuer         String?            @db.VarChar(120)
  issuedDate     DateTime?          @db.Date
  expiresAt      DateTime?          @db.Date
  memo           String?            @db.VarChar(2000)
  status         HomeDocumentStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  home           Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeItem       HomeItem?          @relation(fields: [homeItemId], references: [id], onDelete: SetNull)
  contract       HomeContract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([homeId, status, expiresAt])
  @@index([homeItemId])
  @@index([contractId])
  @@map("home_documents")
}
